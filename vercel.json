{
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "https://gcpachivrwalsneuvlsa.supabase.co/functions/v1/claude-mcp/mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "https://gcpachivrwalsneuvlsa.supabase.co/functions/v1/claude-mcp/.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "https://gcpachivrwalsneuvlsa.supabase.co/functions/v1/claude-mcp/.well-known/oauth-protected-resource/mcp"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "https://gcpachivrwalsneuvlsa.supabase.co/functions/v1/claude-mcp/.well-known/oauth-authorization-server"
    },
    {
      "source": "/oauth/:path*",
      "destination": "https://gcpachivrwalsneuvlsa.supabase.co/functions/v1/claude-mcp/oauth/:path*"
    },
    {
      "source": "/stop/:code",
      "destination": "/stop/index.html"
    },
    {
      "source": "/r/:code",
      "destination": "https://gcpachivrwalsneuvlsa.supabase.co/functions/v1/klik?c=:code"
    },
    {
      "source": "/webinar/:path*",
      "destination": "https://utama-webinar-pages.vercel.app/:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/reserve.html",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/pma",
      "destination": "/heb-je-een-pt-pma-nodig-om-op-bali-te-investeren",
      "permanent": false
    }
  ]
}
